{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"},
          {"key": "X-Content-Type-Options", "value": "nosniff"}
        ]
      }
    ]
  }
}
