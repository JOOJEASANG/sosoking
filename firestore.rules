rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomPath(roomId) { return /databases/$(database)/documents/rooms/$(roomId); }
    function memberPath(roomId, uid) { return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid); }
    function owner(roomId) {
      return signedIn() && get(roomPath(roomId)).data.ownerUid == request.auth.uid;
    }
    function roomOpen(roomId) {
      return exists(roomPath(roomId)) && get(roomPath(roomId)).data.closed == false;
    }
    function member(roomId) {
      return signedIn() && exists(memberPath(roomId, request.auth.uid));
    }
    match /users/{uid}/rooms/{roomId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && member(roomId)
        && request.resource.data.keys().hasOnly(['title','joinedAt','ownerUid','closed'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.ownerUid == get(roomPath(roomId)).data.ownerUid
        && request.resource.data.closed == false
        && request.resource.data.joinedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && owner(roomId) && uid == get(roomPath(roomId)).data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed'])
        && request.resource.data.closed == true;
    }
    match /invites/{token} {
      allow get: if signedIn() && request.time < resource.data.expiresAt;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId','ownerUid','title','createdAt','expiresAt'])
        && request.resource.data.roomId is string
        && request.resource.data.ownerUid == request.auth.uid
        && owner(request.resource.data.roomId)
        && roomOpen(request.resource.data.roomId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }
    match /rooms/{roomId} {
      allow get, list: if signedIn() && (resource.data.ownerUid == request.auth.uid || member(roomId));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','title','createdAt','closed'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.createdAt == request.time
        && request.resource.data.closed == false;
      allow update: if owner(roomId) && resource.data.closed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed','closedAt'])
        && request.resource.data.closed == true
        && request.resource.data.closedAt == request.time;
      allow delete: if false;
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || owner(roomId) || member(roomId));
        allow list: if member(roomId) || owner(roomId);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','inviteToken','joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == request.time
          && request.resource.data.inviteToken is string
          && roomOpen(roomId)
          && (
            (owner(roomId) && request.resource.data.inviteToken == 'owner')
            ||
            (
              request.resource.data.inviteToken != 'owner'
              && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken))
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data.roomId == roomId
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data.expiresAt > request.time
            )
          );
        allow delete: if signedIn() && request.auth.uid == uid && !owner(roomId);
        allow update: if false;
      }
      match /stories/{storyId} {
        allow read: if member(roomId);
        allow create: if member(roomId) && roomOpen(roomId)
          && request.resource.data.keys().hasOnly(['uid','displayName','year','title','body','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 30
          && request.resource.data.year is string && request.resource.data.year.size() <= 4
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.body is string && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1200
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && member(roomId) &&
          (resource.data.uid == request.auth.uid || owner(roomId));
        allow update: if false;
      }
      match /messages/{messageId} {
        allow read: if member(roomId);
        allow create: if member(roomId) && roomOpen(roomId)
          && request.resource.data.keys().hasOnly(['uid','displayName','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 30
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || owner(roomId));
        allow update: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
