rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        ? request.auth.token.email
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (adminEmail() != '' && exists(/databases/$(database)/documents/admins/$(adminEmail())))
      );
    }

    function caseDoc(caseId) {
      return get(/databases/$(database)/documents/cases/$(caseId));
    }

    function publicResultDoc(caseId) {
      return get(/databases/$(database)/documents/public_results/$(caseId));
    }

    function isCaseOwner(caseId) {
      return signedIn() && caseDoc(caseId).data.userId == request.auth.uid;
    }

    function isSafePublicResultData(data) {
      return data.isPublic == true
        && data.publicDataVersion == 1
        && !data.keys().hasAny(['userId', 'caseDescription', 'nickname']);
    }

    function isPublicMirror(caseId) {
      return isSafePublicResultData(publicResultDoc(caseId).data);
    }

    function canReadPublicCourt(caseId) {
      return signedIn() && (
        isPublicMirror(caseId) ||
        isCaseOwner(caseId) ||
        isAdmin()
      );
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (
        request.auth.uid == adminId ||
        adminEmail() == adminId ||
        isAdmin()
      );
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /user_names/{key} {
      allow read, write: if false;
    }

    match /cases/{caseId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /results/{caseId} {
      // Internal results are never public Firestore documents. Public consumers use
      // public_results/getPublicResult; owners and administrators keep direct access.
      allow get: if isCaseOwner(caseId) || isAdmin();
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow create: if false;
      allow delete: if isAdmin();
    }

    match /public_results/{caseId} {
      // 서버 트리거/백필 작업만 쓰고, 공개 이용자는 정제된 단건만 읽는다.
      // 컬렉션 목록은 listPublicResults Callable/Admin SDK 전용으로 유지한다.
      allow get: if isSafePublicResultData(resource.data);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /result_reactions/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;

      match /votes/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    match /court_comments/{caseId}/items/{commentId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_stats/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_authors/{caseId}/items/{commentId} {
      allow read, write: if false;
    }

    // 게임소: 초대 코드를 아는 로그인 세션만 방을 읽고, 진행 상태는 방장이 관리한다.
    match /case_id_aliases/{aliasId} {
      allow read, write: if false;
    }

    match /usage_stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rate_limits/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /action_limits/{limitId} {
      allow read, write: if false;
    }

    match /ai_limits/{dailyId} {
      allow read: if isAdmin();
      allow write: if false;

      match /users/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /report_keys/{keyId} {
      allow read, write: if false;
    }

    match /site_settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /site_public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /policy_docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
