rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        ? request.auth.token.email
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (adminEmail() != '' && exists(/databases/$(database)/documents/admins/$(adminEmail())))
      );
    }

    function caseDoc(caseId) {
      return get(/databases/$(database)/documents/cases/$(caseId));
    }

    function resultDoc(caseId) {
      return get(/databases/$(database)/documents/results/$(caseId));
    }

    function isCaseOwner(caseId) {
      return signedIn() && caseDoc(caseId).data.userId == request.auth.uid;
    }

    function isSafePublicResultData(data) {
      return data.isPublic == true
        && data.publicDataVersion == 1
        && !data.keys().hasAny(['userId', 'caseDescription', 'nickname']);
    }

    function isPublicResultListData(data) {
      return data.isPublic == true && data.publicDataVersion == 1;
    }

    function isResultPublic(caseId) {
      return isSafePublicResultData(resultDoc(caseId).data);
    }

    function canReadPublicCourt(caseId) {
      return signedIn() && (
        isResultPublic(caseId) ||
        isCaseOwner(caseId) ||
        isAdmin()
      );
    }

    function gameRoomExists(roomId) {
      return exists(/databases/$(database)/documents/game_rooms/$(roomId));
    }

    function gameRoomDoc(roomId) {
      return get(/databases/$(database)/documents/game_rooms/$(roomId));
    }

    function gamePlayerExists(roomId, uid) {
      return exists(/databases/$(database)/documents/game_rooms/$(roomId)/players/$(uid));
    }

    function isGameHost(roomId) {
      return signedIn()
        && gameRoomExists(roomId)
        && gameRoomDoc(roomId).data.hostUid == request.auth.uid;
    }

    function isValidGameRoom(data) {
      return data.maxPlayers == 8 && (
        (data.type == 'chosung-bomb' && data.maxRounds == 7) ||
        (data.type == 'mind-reader' && data.maxRounds == 8) ||
        (data.type == 'alibi-market' && data.maxRounds == 3)
      );
    }

    function isVisibleDripsoData(data) {
      return data.status == 'visible';
    }

    function dripsoTopicDoc(topicId) {
      return get(/databases/$(database)/documents/dripso_topics/$(topicId));
    }

    function canReadDripsoComment(topicId, commentData) {
      let topic = dripsoTopicDoc(topicId);
      return isAdmin() || (
        isVisibleDripsoData(commentData)
        && topic.data.status == 'visible'
        && (
          !topic.data.keys().hasAll(['gameVersion'])
          || topic.data.gameVersion == commentData.gameVersion
        )
      );
    }

    match /cases/{caseId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /results/{caseId} {
      allow get: if signedIn() && (
        isSafePublicResultData(resource.data) ||
        isCaseOwner(caseId) ||
        isAdmin()
      );
      allow list: if signedIn() && (
        (resource.data.isPublic == true && resource.data.publicDataVersion == 1) || isAdmin()
      );
      allow write: if false;
    }

    match /public_results/{caseId} {
      allow get, list: if signedIn() && isSafePublicResultData(resource.data);
      allow write: if false;
    }

    match /public_result_originals/{caseId} {
      allow read, write: if false;
    }

    match /case_originals/{caseId} {
      allow read, write: if false;
    }

    match /appeals/{appealId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }

    match /nicknames/{nickname} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /user_settings/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /rate_limits/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /court_votes/{caseId}/items/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /court_comments/{caseId}/items/{commentId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_stats/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_authors/{caseId}/items/{commentId} {
      allow read, write: if false;
    }

    // 게임소: 초대 코드를 아는 로그인 세션만 방을 읽고, 진행 상태는 방장이 관리한다.
    match /game_rooms/{roomId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && isValidGameRoom(request.resource.data);
      allow update, delete: if isGameHost(roomId);

      match /players/{uid} {
        allow read: if signedIn() && gameRoomExists(roomId);
        allow create: if signedIn()
          && gameRoomExists(roomId)
          && gameRoomDoc(roomId).data.status == 'lobby'
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.score == 0
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 12;
        allow update: if signedIn() && gameRoomExists(roomId) && (
          isGameHost(roomId)
          || (
            uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.score == resource.data.score
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'updatedAt'])
            && request.resource.data.nickname is string
            && request.resource.data.nickname.size() > 0
            && request.resource.data.nickname.size() <= 12
          )
        );
        allow delete: if signedIn() && gameRoomExists(roomId) && (
          uid == request.auth.uid || isGameHost(roomId)
        );
      }

      match /answers/{answerId} {
        allow read: if signedIn()
          && gameRoomExists(roomId)
          && gamePlayerExists(roomId, request.auth.uid);
        allow create, update: if signedIn()
          && gameRoomExists(roomId)
          && gamePlayerExists(roomId, request.auth.uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.round == gameRoomDoc(roomId).data.round
          && gameRoomDoc(roomId).data.status == 'playing'
          && gameRoomDoc(roomId).data.roundState == 'open'
          && gameRoomDoc(roomId).data.roundEndsAt is timestamp
          && request.time <= gameRoomDoc(roomId).data.roundEndsAt
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 120;
        allow delete: if isGameHost(roomId);
      }
    }

    // 기존 서비스 데이터는 이전 결과 보존과 단계적 정리를 위해 읽기 규칙을 유지한다.
    match /dripso_topics/{topicId} {
      allow get, list: if isVisibleDripsoData(resource.data) || isAdmin();
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if canReadDripsoComment(topicId, resource.data);
        allow create, update, delete: if false;

        match /likes/{uid} {
          allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
          allow list, create, update, delete: if false;
        }
      }
    }

    match /dripso_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /dripso_battles/{battleId} {
      allow get, list: if isVisibleDripsoData(resource.data) || isAdmin();
      allow write: if false;
    }

    match /dripso_votes/{voteId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }

    match /dripso_reports/{reportId} {
      allow read, write: if false;
    }

    match /dripso_notifications/{uid}/items/{notificationId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /dripso_tournaments/{tournamentId} {
      allow get, list: if isVisibleDripsoData(resource.data) || isAdmin();
      allow write: if false;
    }

    match /dripso_official/{officialId} {
      allow get, list: if isVisibleDripsoData(resource.data) || isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
