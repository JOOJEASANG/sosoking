rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function bootstrapOwner() {
      return signedIn() && adminEmail() == 'sosoday1976@gmail.com';
    }

    function isAdmin() {
      return signedIn() && (
        bootstrapOwner() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (adminEmail() != '' && exists(/databases/$(database)/documents/admins/$(adminEmail())))
      );
    }

    function caseDoc(caseId) {
      return get(/databases/$(database)/documents/cases/$(caseId));
    }

    function resultDoc(caseId) {
      return get(/databases/$(database)/documents/results/$(caseId));
    }

    function isCaseOwner(caseId) {
      return signedIn() && caseDoc(caseId).data.userId == request.auth.uid;
    }

    function isCasePublic(caseId) {
      return caseDoc(caseId).data.isPublic == true;
    }

    function isResultPublic(caseId) {
      return resultDoc(caseId).data.isPublic == true;
    }

    function canReadPublicCourt(caseId) {
      return signedIn() && (
        isCasePublic(caseId) ||
        isResultPublic(caseId) ||
        isCaseOwner(caseId) ||
        isAdmin()
      );
    }

    function validUserProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'nickname', 'provider', 'photoURL', 'avatarSeed', 'avatarType', 'isAnonymous', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.provider is string
        && request.resource.data.provider.size() <= 60
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 500
        && request.resource.data.avatarSeed is string
        && request.resource.data.avatarSeed.size() <= 80
        && request.resource.data.avatarType in ['google', 'generated'];
    }

    function validUserName(key) {
      return request.resource.data.keys().hasOnly(['uid', 'nickname', 'key', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.key == key
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (
        bootstrapOwner() ||
        request.auth.uid == adminId ||
        adminEmail() == adminId ||
        isAdmin()
      );
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && validUserProfile(uid);
      allow update: if signedIn() && request.auth.uid == uid && validUserProfile(uid);
      allow delete: if isAdmin();
    }

    match /user_names/{key} {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/user_names/$(key))
        && validUserName(key);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validUserName(key);
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /cases/{caseId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.isPublic == true ||
        isAdmin()
      );

      // 사건 접수는 rate limit과 금칙어 검사를 수행하는 submitCase 함수로만 허용한다.
      allow create: if false;

      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPublic', 'updatedAt']) &&
        request.resource.data.isPublic is bool &&
        request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin();
    }

    match /results/{caseId} {
      allow read: if signedIn() && (
        isCaseOwner(caseId) ||
        resource.data.isPublic == true ||
        isAdmin()
      );

      // 사용자는 생성된 판결 내용은 바꿀 수 없고 공개 여부만 변경할 수 있다.
      allow update: if isAdmin() || (
        signedIn() &&
        isCaseOwner(caseId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPublic', 'updatedAt']) &&
        request.resource.data.isPublic is bool &&
        request.resource.data.updatedAt == request.time
      );
      allow create: if false;
      allow delete: if isAdmin();
    }

    match /result_reactions/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;

      match /votes/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    match /court_comments/{caseId}/items/{commentId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_stats/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /usage_stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rate_limits/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['caseId', 'reason', 'status', 'createdAt', 'userId'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.caseId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /policy_docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
