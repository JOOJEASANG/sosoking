rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        ? request.auth.token.email
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (adminEmail() != '' && exists(/databases/$(database)/documents/admins/$(adminEmail())))
      );
    }

    function caseDoc(caseId) {
      return get(/databases/$(database)/documents/cases/$(caseId));
    }

    function resultDoc(caseId) {
      return get(/databases/$(database)/documents/results/$(caseId));
    }

    function isCaseOwner(caseId) {
      return signedIn() && caseDoc(caseId).data.userId == request.auth.uid;
    }

    function isSafePublicResultData(data) {
      return data.isPublic == true
        && data.publicDataVersion == 1
        && !data.keys().hasAny(['userId', 'caseDescription', 'nickname']);
    }

    // Firestore 목록 규칙은 쿼리가 증명할 수 있는 필드 조건만 사용한다.
    // 민감 필드 제거는 모든 공개 쓰기 경로와 배포 전 sanitation에서 강제한다.
    function isPublicResultListData(data) {
      return data.isPublic == true && data.publicDataVersion == 1;
    }

    function isResultPublic(caseId) {
      return isSafePublicResultData(resultDoc(caseId).data);
    }

    function canReadPublicCourt(caseId) {
      return signedIn() && (
        isResultPublic(caseId) ||
        isCaseOwner(caseId) ||
        isAdmin()
      );
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (
        request.auth.uid == adminId ||
        adminEmail() == adminId ||
        isAdmin()
      );
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /user_names/{key} {
      allow read, write: if false;
    }

    match /cases/{caseId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /results/{caseId} {
      allow get: if isSafePublicResultData(resource.data)
        || isCaseOwner(caseId)
        || isAdmin();
      allow list: if isAdmin() || isPublicResultListData(resource.data);
      allow update: if isAdmin();
      allow create: if false;
      allow delete: if isAdmin();
    }

    match /result_reactions/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;

      match /votes/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    match /court_comments/{caseId}/items/{commentId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_stats/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_authors/{caseId}/items/{commentId} {
      allow read, write: if false;
    }

    match /case_id_aliases/{aliasId} {
      allow read, write: if false;
    }

    match /usage_stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rate_limits/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /action_limits/{limitId} {
      allow read, write: if false;
    }

    match /ai_limits/{dailyId} {
      allow read: if isAdmin();
      allow write: if false;

      match /users/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /report_keys/{keyId} {
      allow read, write: if false;
    }

    match /site_settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /site_public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /policy_docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
