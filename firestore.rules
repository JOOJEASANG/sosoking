rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        ? request.auth.token.email
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (adminEmail() != '' && exists(/databases/$(database)/documents/admins/$(adminEmail())))
      );
    }

    function caseDoc(caseId) {
      return get(/databases/$(database)/documents/cases/$(caseId));
    }

    function resultDoc(caseId) {
      return get(/databases/$(database)/documents/results/$(caseId));
    }

    function isCaseOwner(caseId) {
      return signedIn() && caseDoc(caseId).data.userId == request.auth.uid;
    }

    function isSafePublicResultData(data) {
      return data.isPublic == true
        && data.publicDataVersion == 1
        && !data.keys().hasAny(['userId', 'caseDescription', 'nickname']);
    }

    function isPublicResultListData(data) {
      return data.isPublic == true && data.publicDataVersion == 1;
    }

    function isResultPublic(caseId) {
      return isSafePublicResultData(resultDoc(caseId).data);
    }

    function canReadPublicCourt(caseId) {
      return signedIn() && (
        isResultPublic(caseId) ||
        isCaseOwner(caseId) ||
        isAdmin()
      );
    }

    function isVisibleDripsoData(data) {
      return data.status == 'visible';
    }

    function dripsoTopicDoc(topicId) {
      return get(/databases/$(database)/documents/dripso_topics/$(topicId));
    }

    function canReadDripsoComment(topicId, commentData) {
      let topic = dripsoTopicDoc(topicId);
      return isAdmin() || (
        isVisibleDripsoData(commentData)
        && topic.data.status == 'visible'
        && (
          !topic.data.keys().hasAll(['gameVersion'])
          || (topic.data.gameVersion != 2 && topic.data.gameVersion != 3)
          || (
            topic.data.gameVersion == 2
            && topic.data.keys().hasAll(['votingDeadline'])
            && request.time >= topic.data.votingDeadline
          )
          || (
            topic.data.gameVersion == 3
            && topic.data.keys().hasAll(['finalDeadline'])
            && request.time >= topic.data.finalDeadline
          )
        )
      );
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (
        request.auth.uid == adminId ||
        adminEmail() == adminId ||
        isAdmin()
      );
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /user_names/{key} {
      allow read, write: if false;
    }

    match /cases/{caseId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /results/{caseId} {
      allow get: if isSafePublicResultData(resource.data)
        || isCaseOwner(caseId)
        || isAdmin();
      allow list: if isAdmin() || isPublicResultListData(resource.data);
      allow update: if isAdmin();
      allow create: if false;
      allow delete: if isAdmin();
    }

    match /result_reactions/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;

      match /votes/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    match /court_comments/{caseId}/items/{commentId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_stats/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_authors/{caseId}/items/{commentId} {
      allow read, write: if false;
    }

    // 드립소 주제는 공개하고, 블라인드 게임 출전작은 각 게임의 최종 종료 뒤에만 직접 읽을 수 있다.
    match /dripso_topics/{topicId} {
      allow get, list: if isVisibleDripsoData(resource.data) || isAdmin();
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if canReadDripsoComment(topicId, resource.data);
        allow create, update, delete: if false;

        match /likes/{uid} {
          allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
          allow list, create, update, delete: if false;
        }
      }
    }

    // 작성자 UID, 익명 예선·토너먼트 대진·투표 기록은 Admin SDK에서만 사용한다.
    match /dripso_topic_authors/{topicId} {
      allow read, write: if false;
    }

    match /dripso_comment_authors/{topicId}/items/{commentId} {
      allow read, write: if false;
    }

    match /dripso_battle_voters/{topicId}/users/{uid}/votes/{voteId} {
      allow read, write: if false;
    }

    match /dripso_tournament_matches/{topicId}/items/{matchId} {
      allow read, write: if false;
    }

    match /dripso_tournament_prelim_voters/{topicId}/users/{uid}/votes/{voteId} {
      allow read, write: if false;
    }

    match /dripso_tournament_voters/{topicId}/rounds/{roundId}/matches/{matchId}/users/{uid} {
      allow read, write: if false;
    }

    match /dripso_reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /dripso_report_keys/{keyId} {
      allow read, write: if false;
    }

    match /case_id_aliases/{aliasId} {
      allow read, write: if false;
    }

    match /usage_stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rate_limits/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /action_limits/{limitId} {
      allow read, write: if false;
    }

    match /ai_limits/{dailyId} {
      allow read: if isAdmin();
      allow write: if false;

      match /users/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /report_keys/{keyId} {
      allow read, write: if false;
    }

    match /site_settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /site_public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /policy_docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
