rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (adminEmail() != '' && exists(/databases/$(database)/documents/admins/$(adminEmail())))
      );
    }

    function caseDoc(caseId) {
      return get(/databases/$(database)/documents/cases/$(caseId));
    }

    function resultDoc(caseId) {
      return get(/databases/$(database)/documents/results/$(caseId));
    }

    function isCaseOwner(caseId) {
      return signedIn() && caseDoc(caseId).data.userId == request.auth.uid;
    }

    function isSafePublicResultData(data) {
      return data.isPublic == true
        && data.publicDataVersion == 1
        && !data.keys().hasAny(['userId', 'caseDescription', 'nickname']);
    }

    function isPublicResultListData(data) {
      return data.isPublic == true && data.publicDataVersion == 1;
    }

    function isResultPublic(caseId) {
      return isSafePublicResultData(resultDoc(caseId).data);
    }

    function canReadPublicCourt(caseId) {
      return signedIn() && (
        isResultPublic(caseId) ||
        isCaseOwner(caseId) ||
        isAdmin()
      );
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (
        request.auth.uid == adminId ||
        adminEmail() == adminId ||
        isAdmin()
      );
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 프로필과 닉네임은 setNickname 함수의 단일 트랜잭션에서만 변경한다.
      // 클라이언트 직접 쓰기를 허용하면 user_names 예약과 프로필이 불일치할 수 있다.
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /user_names/{key} {
      // 닉네임 중복 확인과 예약은 checkNickname/setNickname 함수만 사용한다.
      // UID-닉네임 매핑은 공개 목록으로 노출하지 않는다.
      allow read, write: if false;
    }

    match /cases/{caseId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // 사건 접수는 rate limit과 금칙어 검사를 수행하는 submitCase 함수로만 허용한다.
      allow create: if false;

      // 공개 상태도 setResultVisibility 함수가 cases/results에 원자적으로 반영한다.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /results/{caseId} {
      // 공개용으로 정리된 결과는 로그인 전에도 읽을 수 있다. 원문 cases 문서는 계속 비공개다.
      allow get: if isSafePublicResultData(resource.data)
        || isCaseOwner(caseId)
        || isAdmin();

      // 목록 쿼리는 isPublic/publicDataVersion 필터를 모두 포함해야 한다.
      allow list: if isPublicResultListData(resource.data);

      // 공개 전환 시 인증 UID와 공개 불필요 원문 필드를 제거하도록 서버 함수만 사용한다.
      allow update: if isAdmin();
      allow create: if false;
      allow delete: if isAdmin();
    }

    match /result_reactions/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;

      match /votes/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    match /court_comments/{caseId}/items/{commentId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    match /court_comment_stats/{caseId} {
      allow read: if canReadPublicCourt(caseId);
      allow write: if false;
    }

    // 댓글 작성자 UID는 공개 댓글 문서와 분리하며 서버와 관리자 작업에서만 사용한다.
    match /court_comment_authors/{caseId}/items/{commentId} {
      allow read, write: if false;
    }

    // 실제 판례 게임의 정답·투표·개인 기록은 callable 함수에서만 취급한다.
    match /daily_court_catalog/{caseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /daily_court_config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /daily_court_days/{dateKey} {
      allow read: if isAdmin();
      allow write: if false;

      match /votes/{uid} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /daily_court_players/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 과거 UID 포함 사건 주소는 SHA-256 해시 별칭으로만 보관하고 서버 함수로만 해석한다.
    match /case_id_aliases/{aliasId} {
      allow read, write: if false;
    }

    match /usage_stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rate_limits/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /action_limits/{limitId} {
      allow read, write: if false;
    }

    match /ai_limits/{dailyId} {
      allow read: if isAdmin();
      allow write: if false;

      match /users/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      // 신고 생성은 로그인·중복·횟수 제한을 수행하는 submitReport 함수만 사용한다.
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /report_keys/{keyId} {
      allow read, write: if false;
    }

    match /site_settings/{docId} {
      // AI 프롬프트, 금칙어, 비용 설정 등 운영 내부값은 관리자만 읽는다.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /site_public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /policy_docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
